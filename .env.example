# ==============================================================================
# RAG Document AI Worker - Environment Configuration Template (.env.example)
#
# IMPORTANT ARCHITECTURAL NOTE ON DEPLOYMENTS:
# Changes in '.env' ONLY affect local runs/testing and DO NOT propagate to deployments.
# ONLY changes in '.env.prod' affect Kubernetes & Helm manifests in 'deployments/'
# (synchronized via scripts/sync_env_to_deployments.py and enforced by pre-commit hooks).
# ==============================================================================

ENVIRONMENT=production
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Temporal
TEMPORAL_HOST=temporal-frontend.temporal.svc.cluster.local:7233
TEMPORAL_NAMESPACE=doc-ai-prod
VISION_TASK_QUEUE=doc-ai-vision-queue
AUDIO_TASK_QUEUE=doc-ai-audio-queue
HEARTBEAT_INTERVAL_SECONDS=10.0
HEARTBEAT_TIMEOUT_SECONDS=30.0

# HTTP Probe & Observability Server
PROBE_HOST=0.0.0.0
PROBE_PORT=8080

# Downstream gRPC & Storage
# Fixed FQDN including namespace: rag-chunk-lifecycle-service.<namespace>.svc.cluster.local:50051
CHUNK_SERVICE_ENDPOINT=rag-chunk-lifecycle-service.default.svc.cluster.local:50051

# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Hugging Face (Required for Audio Worker / PyAnnote Diarization)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model Caches
MODEL_CACHE_DIR=/models/cache
HF_HOME=/models/cache/huggingface
TORCH_HOME=/models/cache/torch
DOCLING_CACHE_DIR=/models/cache/docling
WHISPER_CACHE_DIR=/models/cache/whisper
PPOCR_HOME=/tmp/.paddleocr

# Audio Configuration
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
PYANNOTE_MODEL_ID=pyannote/speaker-diarization-3.1
AUDIO_SAMPLE_RATE=16000
AUDIO_PROGRESS_STEP_SECONDS=30.0

# Vision Configuration
OCR_CONFIDENCE_THRESHOLD=0.80
TABLE_PARQUET_COMPRESSION=snappy

# Memory & CUDA allocator
LD_PRELOAD=/usr/lib/libjemalloc.so
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
VRAM_THRESHOLD_BYTES=21474836480

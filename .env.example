# ==============================================================================
# RAG Document AI Worker (rag-document-ai-worker) - Production Environment Template
# ==============================================================================
# Usage:
#   Copy this file to '.env' and provide your target deployment coordinates:
#     cp .env.example .env
#
# Security & Operational Invariants:
#   1. In production Kubernetes clusters, sensitive credentials (HF_TOKEN, AWS keys)
#      must be mounted via Kubernetes Secrets or IAM Roles for Service Accounts (IRSA).
#   2. Customer document text, transcripts, and presigned URLs are strictly scrubbed
#      from JSON logs when ENVIRONMENT is set to 'production' or 'staging'.
#   3. Model weights are mounted from high-performance NVMe PersistentVolumeClaims
#      at /models/cache in read-only mode (ReadOnlyMany) to avoid network downloads.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & PROCESS ENVIRONMENT
# ------------------------------------------------------------------------------
# Deployment environment: 'development', 'staging', or 'production'.
# Setting to 'production' enables structured JSON logging via structlog, sets log level
# to INFO, and activates zero-PII/zero-text redaction filters.
ENVIRONMENT=production

# Ensure Python stdout/stderr streams are unbuffered for immediate log ingestion
PYTHONUNBUFFERED=1

# Prevent Python from attempting to write .pyc bytecode files to read-only container rootfs
PYTHONDONTWRITEBYTECODE=1

# ------------------------------------------------------------------------------
# 2. TEMPORAL WORKFLOW & ACTIVITY ORCHESTRATION
# ------------------------------------------------------------------------------
# Temporal frontend service endpoint (host:port).
# In production Kubernetes: temporal-frontend.temporal.svc.cluster.local:7233
# In Temporal Cloud: <namespace>.<account>.tmprl.cloud:7233
TEMPORAL_HOST=temporal-frontend.temporal.svc.cluster.local:7233

# Temporal namespace for workflow and activity execution
TEMPORAL_NAMESPACE=default

# Dedicated Temporal task queue for vision worker activities (Docling & Fallback OCR)
VISION_TASK_QUEUE=doc-ai-vision-queue

# Dedicated Temporal task queue for audio worker activities (Whisper & PyAnnote)
AUDIO_TASK_QUEUE=doc-ai-audio-queue

# Frequency in seconds at which the background heartbeat runner emits progress checkpoints
HEARTBEAT_INTERVAL_SECONDS=10.0

# Heartbeat timeout buffer in seconds against garbage collection or GPU batch latency
HEARTBEAT_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 3. HTTP DOCUMENTATION, HEALTH PROBES & TELEMETRY
# ------------------------------------------------------------------------------
# Network bind interface for the internal FastAPI ASGI server
PROBE_HOST=0.0.0.0

# HTTP port for OpenAPI 3.1 documentation (/docs, /redoc, /api/docs, /openapi.json),
# Kubernetes health probes (/healthz, /ready), and Prometheus metrics (/metrics)
PROBE_PORT=8080

# ------------------------------------------------------------------------------
# 4. PRE-BAKED MODEL WEIGHTS & CACHE STORAGE (NVMe PVC)
# ------------------------------------------------------------------------------
# Base persistent volume mount directory for pre-baked models (Read-only NVMe PVC)
MODEL_CACHE_DIR=/models/cache

# Hugging Face cache directory for transformer weights, tokenizers, and PyAnnote models
HF_HOME=/models/cache/huggingface

# PyTorch weights and Hub cache directory
TORCH_HOME=/models/cache/torch

# Docling layout and table model artifacts cache directory
DOCLING_CACHE_DIR=/models/cache/docling

# Faster-Whisper / CTranslate2 model weights cache directory
WHISPER_CACHE_DIR=/models/cache/whisper

# ------------------------------------------------------------------------------
# 5. HUGGING FACE AUTHENTICATION & GATED MODELS
# ------------------------------------------------------------------------------
# Hugging Face User Access Token (read permission).
# Required in production for accessing gated pyannote/speaker-diarization-3.1 model weights
# (ensure you accept the license agreement at https://huggingface.co/pyannote/speaker-diarization-3.1).
HF_TOKEN=hf_your_production_read_token_here

# PyAnnote model repository identifier for speaker diarization
PYANNOTE_MODEL_ID=pyannote/speaker-diarization-3.1

# ------------------------------------------------------------------------------
# 6. VISION & TABULAR EXTRACTION CONFIGURATION
# ------------------------------------------------------------------------------
# Confidence floor [0.0 - 1.0] below which layout bounding boxes trigger secondary PaddleOCR
OCR_CONFIDENCE_THRESHOLD=0.80

# Compression codec for PyArrow Parquet table exports: 'snappy', 'zstd', or 'gzip'
TABLE_PARQUET_COMPRESSION=snappy

# ------------------------------------------------------------------------------
# 7. AUDIO SPEECH-TO-TEXT (ASR) & DIARIZATION CONFIGURATION
# ------------------------------------------------------------------------------
# Faster-Whisper model variant: 'tiny', 'base', 'small', 'medium', or 'large-v3'
WHISPER_MODEL_SIZE=large-v3

# Inference hardware target: 'cuda' (production GPU) or 'cpu' (fallback)
WHISPER_DEVICE=cuda

# Model precision / quantization: 'float16' (Tensor Cores), 'int8_float16', or 'float32'
WHISPER_COMPUTE_TYPE=float16

# Beam search width for Whisper decoding
WHISPER_BEAM_SIZE=5

# Native audio sample rate in Hz for Whisper and PyAnnote feature extractors
AUDIO_SAMPLE_RATE=16000

# Progressive window interval chunk size in seconds for streaming and checkpointing
AUDIO_PROGRESS_STEP_SECONDS=30.0

# ------------------------------------------------------------------------------
# 8. DOWNSTREAM INTER-SERVICE COMMUNICATION (gRPC HTTP/2)
# ------------------------------------------------------------------------------
# Downstream gRPC chunk lifecycle endpoint for streaming extracted ASTs and transcripts
# In production Kubernetes: rag-chunk-lifecycle-service.svc.cluster.local:50051
CHUNK_SERVICE_ENDPOINT=rag-chunk-lifecycle-service:50051

# ------------------------------------------------------------------------------
# 9. OBJECT STORAGE (AWS S3 / S3-COMPATIBLE)
# ------------------------------------------------------------------------------
# AWS Region for physical slice reads and tabular Parquet writes
AWS_REGION=us-east-1

# Optional custom S3 endpoint URL (set for MinIO, LocalStack, or private S3 gateway; leave empty for AWS S3)
S3_ENDPOINT_URL=

# AWS Credentials (optional if using AWS IRSA / IAM Roles for Service Accounts)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_SESSION_TOKEN=

# ------------------------------------------------------------------------------
# 10. GPU MEMORY MANAGEMENT & ALLOCATOR TUNING (PRODUCTION INVARIANTS)
# ------------------------------------------------------------------------------
# GPU VRAM safety threshold ceiling in bytes before triggering alert (default: 20 GiB = 21474836480)
VRAM_THRESHOLD_BYTES=21474836480

# Preload jemalloc allocator to prevent Linux glibc heap fragmentation and memory leaks
LD_PRELOAD=/usr/lib/libjemalloc.so

# PyTorch CUDA memory allocator tuning to eliminate GPU VRAM fragmentation
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# Dedicated GPU device assignment for the container
CUDA_VISIBLE_DEVICES=0

# Restrict threading pools to avoid CPU core contention with Temporal event loops
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2

# ------------------------------------------------------------------------------
# 11. TEMPORAL MUTUAL TLS (mTLS) & SECURITY (OPTIONAL)
# ------------------------------------------------------------------------------
# Certificate paths if connecting to an mTLS-secured Temporal cluster or Temporal Cloud
# TEMPORAL_TLS_CERT=/etc/tls/temporal/client.crt
# TEMPORAL_TLS_KEY=/etc/tls/temporal/client.key
# TEMPORAL_TLS_CA=/etc/tls/temporal/ca.crt
# TEMPORAL_API_KEY=

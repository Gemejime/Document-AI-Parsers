# ==============================================================================
# RAG Document AI Worker - Comprehensive Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development or staging, or use it to populate
# Kubernetes Secrets / ConfigMaps in production.
#
# ------------------------------------------------------------------------------
# QUICK PRODUCTION CHECKLIST (AFFECTED / CRITICAL VARIABLES):
# 1. TEMPORAL_HOST: Must point to reachable cluster frontend (FQDN:port), not localhost.
# 2. TEMPORAL_NAMESPACE: Must be created in Temporal and match orchestrator (e.g. doc-ai-prod).
# 3. CHUNK_SERVICE_ENDPOINT: Must include target Kubernetes namespace (<svc>.<ns>.svc.cluster.local:50051).
# 4. HF_TOKEN: Required for Audio Worker (PyAnnote gated model weights).
# 5. AWS_REGION: Must match your production S3 bucket region.
# 6. S3_ENDPOINT_URL: Leave blank for standard AWS S3; specify if using MinIO / VPC endpoint.
# 7. PPOCR_HOME: Must be pointed to a writable directory (/tmp/.paddleocr) for read-only containers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & LOGGING
# ------------------------------------------------------------------------------
# [AFFECTED IN PRODUCTION]
# Deployment tier: 'development', 'staging', or 'production'.
# In production, switching to 'production' enforces structured JSON line output
# with automatic PII/token redaction. In development, colored console logs are used.
ENVIRONMENT=production

# Python runtime performance and log streaming flags
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1


# ------------------------------------------------------------------------------
# 2. TEMPORAL WORKFLOW ORCHESTRATION
# ------------------------------------------------------------------------------
# [AFFECTED IN PRODUCTION]
# Address and port of the Temporal Frontend service.
# - Production (in-cluster): 'temporal-frontend.<temporal-namespace>.svc.cluster.local:7233'
# - Note: Current worker connection is plaintext gRPC. Do not point to Temporal Cloud
#   or clusters requiring mTLS without enabling TLS certificates in worker client.
TEMPORAL_HOST=temporal-frontend.temporal.svc.cluster.local:7233

# [AFFECTED IN PRODUCTION]
# Target Temporal namespace for workflow and activity execution.
# Production recommendation: Use an isolated namespace (e.g. 'doc-ai-prod').
# Ensure this namespace is pre-registered in Temporal ('temporal operator namespace create doc-ai-prod').
TEMPORAL_NAMESPACE=doc-ai-prod

# Dedicated Temporal task queues polled by workers.
# Matches Helm chart deployment values (doc-ai-vision-queue or doc-ai-audio-queue).
VISION_TASK_QUEUE=doc-ai-vision-queue
AUDIO_TASK_QUEUE=doc-ai-audio-queue

# Heartbeat interval emitted to Temporal during activity execution (in seconds).
# Must emit every 10 seconds per system SLI/SLO invariants.
HEARTBEAT_INTERVAL_SECONDS=10.0

# Heartbeat timeout buffer guarding against GC pauses and GPU batch jitter (in seconds).
HEARTBEAT_TIMEOUT_SECONDS=30.0


# ------------------------------------------------------------------------------
# 3. HTTP PROBE & OBSERVABILITY SERVER
# ------------------------------------------------------------------------------
# Network bind address and port for FastAPI ASGI operational server
# Exposes /docs, /redoc, /api/docs, /healthz, /ready, and /metrics.
PROBE_HOST=0.0.0.0
PROBE_PORT=8080


# ------------------------------------------------------------------------------
# 4. DOWNSTREAM gRPC SERVICES & STORAGE
# ------------------------------------------------------------------------------
# [AFFECTED IN PRODUCTION]
# Downstream gRPC chunk lifecycle endpoint for streaming AST nodes and audio segments.
# CRITICAL: Always specify the full Kubernetes FQDN with target namespace:
# Format: '<service-name>.<namespace>.svc.cluster.local:<port>'
# Example: 'rag-chunk-lifecycle-service.default.svc.cluster.local:50051'
# (Set to 'mock' only for offline / local testing without downstream service).
CHUNK_SERVICE_ENDPOINT=rag-chunk-lifecycle-service.default.svc.cluster.local:50051

# [AFFECTED IN PRODUCTION]
# AWS region where document slices and table Parquet artifacts reside.
# Change to your production cloud region (e.g. us-east-1, eu-west-1, us-west-2).
AWS_REGION=us-east-1

# [AFFECTED IN PRODUCTION]
# Optional custom S3 endpoint URL.
# Leave commented out or empty for standard AWS S3.
# Set for MinIO, LocalStack, or VPC S3 gateway endpoints (e.g. http://minio.storage.svc.cluster.local:9000).
# S3_ENDPOINT_URL=


# ------------------------------------------------------------------------------
# 5. MODEL CACHE & PERSISTENT VOLUMES (GPU / NVMe)
# ------------------------------------------------------------------------------
# Base path for pre-baked model weights mounted on read-only NVMe PVC.
MODEL_CACHE_DIR=/models/cache
HF_HOME=/models/cache/huggingface
TORCH_HOME=/models/cache/torch
DOCLING_CACHE_DIR=/models/cache/docling
WHISPER_CACHE_DIR=/models/cache/whisper

# [AFFECTED IN PRODUCTION]
# PaddleOCR cache directory for fallback OCR.
# When running with readOnlyRootFilesystem: true, point this to a writable directory
# such as /tmp/.paddleocr to avoid PermissionError / Read-only file system exceptions.
PPOCR_HOME=/tmp/.paddleocr


# ------------------------------------------------------------------------------
# 6. AUDIO WORKER (Faster-Whisper & PyAnnote Diarization)
# ------------------------------------------------------------------------------
# [AFFECTED IN PRODUCTION]
# Hugging Face User Access Token (read permission).
# CRITICAL FOR AUDIO WORKER: PyAnnote 3.1 is a gated repository.
# You MUST visit https://huggingface.co/pyannote/speaker-diarization-3.1 and
# https://huggingface.co/pyannote/segmentation-3.0 to accept model agreements.
# This token is automatically scrubbed from structured logs.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Faster-Whisper ASR model parameters
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5

# PyAnnote Diarization model repository
PYANNOTE_MODEL_ID=pyannote/speaker-diarization-3.1

# Audio pipeline processing constants
AUDIO_SAMPLE_RATE=16000
AUDIO_PROGRESS_STEP_SECONDS=30.0


# ------------------------------------------------------------------------------
# 7. VISION WORKER (Docling Layout & PaddleOCR Fallback)
# ------------------------------------------------------------------------------
# Confidence floor below which secondary PaddleOCR fallback pass is triggered (0.0 - 1.0).
OCR_CONFIDENCE_THRESHOLD=0.80

# Compression codec for extracted tabular PyArrow Parquet exports ('snappy', 'zstd', or 'gzip').
TABLE_PARQUET_COMPRESSION=snappy


# ------------------------------------------------------------------------------
# 8. HARDWARE, CUDA & MEMORY MANAGEMENT
# ------------------------------------------------------------------------------
# Maximum GPU VRAM ceiling before preemptive memory compaction triggers (20 GiB = 21474836480 bytes).
VRAM_THRESHOLD_BYTES=21474836480

# Memory allocator optimizations
LD_PRELOAD=/usr/lib/libjemalloc.so
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# Thread bounds for OpenMP and OpenBLAS to prevent CPU contention during GPU offload
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
